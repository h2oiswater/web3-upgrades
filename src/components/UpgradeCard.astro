---
import { getCollection } from 'astro:content';

interface Props {
  upgrade: {
    id: string;
    name: string;
    nameZh?: string;
    date?: string;
    blockNumber?: string;
    type: string[];
    icon?: string;
    summary: string;
    summaryZh?: string;
  };
  index: number;
  chainId: string;
}

const { upgrade, index, chainId } = Astro.props;
const isLeft = index % 2 === 0;
const baseUrl = import.meta.env.BASE_URL;

// 读取该升级的特性
const allItems = await getCollection('chains');
const upgradeFeatures = allItems
  .filter(f => f.data.upgradeId === upgrade.id && f.data.chainId === chainId)
  .sort((a, b) => (a.data.sortOrder || 999) - (b.data.sortOrder || 999));

const typeLabels: Record<string, string> = {
  execution: '执行层',
  consensus: '共识层',
  l2: '扩容/L2',
  economic: '经济模型',
  security: '安全',
  major: '里程碑',
};

const typeColors: Record<string, string> = {
  execution: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
  consensus: 'bg-purple-500/10 text-purple-400 border-purple-500/20',
  l2: 'bg-green-500/10 text-green-400 border-green-500/20',
  economic: 'bg-orange-500/10 text-orange-400 border-orange-500/20',
  security: 'bg-red-500/10 text-red-400 border-red-500/20',
  major: 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20',
};
---

<div class={`relative flex items-start gap-4 md:gap-8 ${isLeft ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
  {/* 移动端时间线节点 */}
  <div class="absolute left-4 md:left-1/2 w-4 h-4 rounded-full bg-[#0a0a0f] border-2 border-[#627eea] mt-6 z-10 md:-translate-x-1/2"/>
  
  {/* 左侧空白（桌面端） */}
  <div class="hidden md:block flex-1"/>
  
  {/* 内容卡片 */}
  <div class="flex-1 ml-12 md:ml-0">
    <a 
      href={`${baseUrl}${chainId}/${upgrade.id}/`}
      class="block p-5 rounded-xl border border-[#2a2a3a] bg-[#16161e] hover:bg-[#1c1c26] hover:border-[#3a3a50] transition-all"
    >
      <div class="flex items-center gap-3 mb-3">
        <span class="text-2xl">{upgrade.icon}</span>
        <div>
          <h3 class="text-lg font-bold text-white">{upgrade.nameZh || upgrade.name}</h3>
          {upgrade.blockNumber && (
            <span class="text-xs text-[#6a6a80]">区块 {upgrade.blockNumber}</span>
          )}
        </div>
      </div>
      
      <p class="text-sm text-[#9a9ab0] mb-3 line-clamp-2">{upgrade.summaryZh || upgrade.summary}</p>
      
      {/* 类型标签 */}
      <div class="flex gap-2 flex-wrap mb-3">
        {upgrade.type.map(t => (
          <span class={`px-2 py-0.5 rounded text-xs border ${typeColors[t] || 'bg-[#2a2a3a] text-[#9a9ab0]'}`}>
            {typeLabels[t] || t}
          </span>
        ))}
      </div>
      
      {/* 特性列表 */}
      {upgradeFeatures.length > 0 && (
        <div class="flex gap-2 flex-wrap">
          {upgradeFeatures.slice(0, 4).map(f => (
            <span class="text-xs px-2 py-1 rounded bg-[#0a0a0f] text-[#6a6a80] border border-[#2a2a3a]">
              {f.data.type === 'eip' ? `EIP-${f.data.number}` : f.data.nameZh || f.data.name}
            </span>
          ))}
          {upgradeFeatures.length > 4 && (
            <span class="text-xs px-2 py-1 rounded bg-[#0a0a0f] text-[#6a6a80]">
              +{upgradeFeatures.length - 4}
            </span>
          )}
        </div>
      )}
      
      {upgrade.date && (
        <div class="mt-3 text-xs text-[#6a6a80]">
          📅 {upgrade.date}
        </div>
      )}
    </a>
  </div>
  
  {/* 右侧空白（桌面端） */}
  <div class="hidden md:block flex-1"/>
</div>
