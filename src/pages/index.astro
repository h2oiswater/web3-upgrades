---
import Layout from '../layouts/Layout.astro';
import ChainCard from '../components/ChainCard.astro';
import { getCollection } from 'astro:content';

const allItems = await getCollection('chains');
// 链级别的 item 没有 chainId 字段
const chains = allItems.filter(item => !item.data.chainId);
const sortedChains = chains.sort((a, b) => (a.data.sortOrder || 999) - (b.data.sortOrder || 999));
---

<Layout title="Web3 Upgrades" description="区块链协议升级知识库 - 以太坊、比特币等主流公链的历次升级记录">
  <main class="min-h-screen bg-[#0A0A0F]">
    <!-- Hero - 极简科技风 -->
    <section class="relative py-20 px-4 text-center overflow-hidden bg-[#0A0A0F]">
      <div class="relative z-10 max-w-3xl mx-auto">
        <div class="w-16 h-16 mx-auto mb-6 rounded-xl bg-[#16161e] border border-[#2a2a3a] flex items-center justify-center text-2xl font-bold text-[#3b82f6]">
          Ξ
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white">以太坊协议升级知识库</h1>
        <p class="text-lg text-[#9a9ab0] max-w-xl mx-auto">从 Frontier 到 Fusaka，追踪以太坊每一次协议进化。EIP 深度解读 + 官方技术规格。</p>
        
        <div class="mt-4">
          <span class="inline-block px-3 py-1 text-xs text-[#6a6a80] border border-[#2a2a3a] rounded-full">更多链支持即将推出</span>
        </div>
        
        <div class="flex justify-center gap-8 mt-10">
          <div class="text-center">
            <div class="text-3xl font-bold text-white">20+</div>
            <div class="text-sm text-[#6a6a80]">次重大升级</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-white">11年</div>
            <div class="text-sm text-[#6a6a80]">持续演进</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-white">60+</div>
            <div class="text-sm text-[#6a6a80]">核心 EIP 详解</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Chain Cards -->
    <section class="max-w-6xl mx-auto px-4 pb-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedChains.map(chain => (
          <ChainCard chain={chain.data} />
        ))}
      </div>
    </section>
  </main>
</Layout>
