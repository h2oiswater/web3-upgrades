---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { readFileSync } from 'fs';
import { join } from 'path';
import { marked } from 'marked';

export async function getStaticPaths() {
  const allItems = await getCollection('chains');
  const features = allItems.filter(item => item.data.upgradeId && item.data.chainId);
  return features.map(f => ({
    params: { 
      chain: f.data.chainId,
      upgrade: f.data.upgradeId,
      feature: f.data.id
    },
    props: { featureData: f.data },
  }));
}

const { chain, upgrade, feature } = Astro.params;
const { featureData } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

// 读取 Markdown 文件
let originalContent = '';
let aiContent = '';

const dataDir = join(process.cwd(), 'data', chain, upgrade, feature);

try {
  originalContent = readFileSync(join(dataDir, 'original-zh.md'), 'utf-8');
} catch {
  originalContent = '# 暂无技术原文\n\n官方 EIP 文档尚未收录。';
}

try {
  aiContent = readFileSync(join(dataDir, 'ai-introduce-zh.md'), 'utf-8');
} catch {
  aiContent = '# 暂无 AI 解读\n\n正在生成中...';
}

// 建立 EIP → 升级 映射（用于站内链接）
const allItems = await getCollection('chains');
const eipToUpgrade: Record<string, string> = {};
for (const item of allItems) {
  if (item.data.type === 'eip' && item.data.number && item.data.upgradeId) {
    eipToUpgrade[String(item.data.number)] = item.data.upgradeId;
  }
}

// 自定义 marked 渲染器
const renderer = new marked.Renderer();

// 表格包装器
renderer.table = function({ header, rows }) {
  const buildCell = (cell) => {
    const inner = this.parser.parseInline(cell.tokens);
    return cell.header ? `<th>${inner}</th>` : `<td>${inner}</td>`;
  };
  const headerRow = `<tr>${header.map(buildCell.bind(this)).join('')}</tr>`;
  const bodyRows = rows.map(row => `<tr>${row.map(buildCell.bind(this)).join('')}</tr>`).join('');
  return `<div class="table-wrapper"><table><thead>${headerRow}</thead><tbody>${bodyRows}</tbody></table></div>`;
};

// 代码块
renderer.code = ({ text, lang }) => {
  return `<pre><code class="language-${lang || 'text'}">${text.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</code></pre>`;
};

// 链接处理：EIP 链接转为站内
renderer.link = ({ href, title, text }) => {
  // 处理 GitHub EIP 链接 → 站内链接
  const eipMatch = href.match(/eip-(\d+)\.md$/);
  if (eipMatch) {
    const eipNum = eipMatch[1];
    const targetUpgrade = eipToUpgrade[eipNum];
    if (targetUpgrade) {
      return `<a href="${baseUrl}${chain}/${targetUpgrade}/eip-${eipNum}/">${text}</a>`;
    }
  }
  // 处理相对 EIP 链接
  const relMatch = href.match(/^\.\/eip-(\d+)\.md$/);
  if (relMatch) {
    const eipNum = relMatch[1];
    const targetUpgrade = eipToUpgrade[eipNum];
    if (targetUpgrade) {
      return `<a href="${baseUrl}${chain}/${targetUpgrade}/eip-${eipNum}/">${text}</a>`;
    }
  }
  return `<a href="${href}"${title ? ` title="${title}"` : ''}${href.startsWith('http') ? ' target="_blank" rel="noopener"' : ''}>${text}</a>`;
};

marked.setOptions({
  renderer,
  gfm: true,
  breaks: true,
});

// 渲染 HTML
const originalHtml = marked.parse(originalContent);
const aiHtml = marked.parse(aiContent);

// 获取升级信息用于面包屑
const upgradeData = allItems.find(u => u.data.id === upgrade && !u.data.upgradeId)?.data;
const chainData = allItems.find(c => c.data.id === chain && !c.data.chainId)?.data;

const impactLabels: Record<string, { label: string; color: string }> = {
  high: { label: '🔴 高影响', color: 'text-red-400 bg-red-500/10 border-red-500/20' },
  medium: { label: '🟡 中影响', color: 'text-yellow-400 bg-yellow-500/10 border-yellow-500/20' },
  low: { label: '🟢 低影响', color: 'text-green-400 bg-green-500/10 border-green-500/20' },
};

const impact = impactLabels[featureData.impact || 'medium'] || impactLabels.medium;
---

<Layout title={`${featureData.id} ${featureData.nameZh || featureData.name}`} description={featureData.nameZh || featureData.name}>
  <main class="min-h-screen max-w-4xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-[#6a6a80] mb-8">
      <a href={baseUrl} class="hover:text-[#8aa4f0]">首页</a>
      <span>/</span>
      {chainData && <a href={`${baseUrl}${chain}/`} class="hover:text-[#8aa4f0]">{chainData.nameZh}</a>}
      <span>/</span>
      {upgradeData && <a href={`${baseUrl}${chain}/${upgrade}/`} class="hover:text-[#8aa4f0]">{upgradeData.nameZh || upgradeData.name}</a>}
      <span>/</span>
      <span class="text-[#9a9ab0]">{featureData.nameZh || featureData.name}</span>
    </nav>

    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        {featureData.type === 'eip' && featureData.number && (
          <span class="font-mono text-sm px-3 py-1 rounded bg-[#627eea]/10 text-[#8aa4f0] border border-[#627eea]/20">
            EIP-{featureData.number}
          </span>
        )}
        <h1 class="text-3xl font-bold text-white">{featureData.nameZh || featureData.name}</h1>
      </div>
      
      <div class="flex gap-2 flex-wrap">
        <span class={`px-3 py-1 rounded text-sm border ${impact.color}`}>{impact.label}</span>
        {featureData.category && (
          <span class="px-3 py-1 rounded text-sm bg-[#16161e] text-[#9a9ab0] border border-[#2a2a3a]">{featureData.category}</span>
        )}
        {featureData.major && (
          <span class="px-3 py-1 rounded text-sm bg-orange-500/10 text-orange-400 border border-orange-500/20">⭐ 核心特性</span>
        )}
      </div>
    </div>

    <!-- Tabs -->
    <div class="flex gap-1 mb-6 border-b border-[#2a2a3a]">
      <button 
        id="tab-ai"
        class="pb-3 px-4 text-[#8aa4f0] border-b-2 border-[#3b82f6] font-medium transition-colors"
        onclick="switchTab('ai')"
      >
        🤖 AI 解读
      </button>
      <button 
        id="tab-original"
        class="pb-3 px-4 text-[#6a6a80] hover:text-[#9a9ab0] font-medium transition-colors border-b-2 border-transparent"
        onclick="switchTab('original')"
      >
        📋 官方原文
      </button>
    </div>

    <!-- Content -->
    <div id="content-ai" class="markdown-content">
      <Fragment set:html={aiHtml} />
    </div>
    
    <div id="content-original" class="markdown-content hidden">
      <Fragment set:html={originalHtml} />
    </div>
  </main>

  <script is:inline>
    function switchTab(tab) {
      const tabOriginal = document.getElementById('tab-original');
      const tabAi = document.getElementById('tab-ai');
      const contentOriginal = document.getElementById('content-original');
      const contentAi = document.getElementById('content-ai');
      
      if (tab === 'ai') {
        tabAi.classList.add('text-[#8aa4f0]', 'border-[#3b82f6]');
        tabAi.classList.remove('text-[#6a6a80]', 'border-transparent');
        tabOriginal.classList.remove('text-[#8aa4f0]', 'border-[#3b82f6]');
        tabOriginal.classList.add('text-[#6a6a80]', 'border-transparent');
        contentAi.classList.remove('hidden');
        contentOriginal.classList.add('hidden');
      } else {
        tabOriginal.classList.add('text-[#8aa4f0]', 'border-[#3b82f6]');
        tabOriginal.classList.remove('text-[#6a6a80]', 'border-transparent');
        tabAi.classList.remove('text-[#8aa4f0]', 'border-[#3b82f6]');
        tabAi.classList.add('text-[#6a6a80]', 'border-transparent');
        contentOriginal.classList.remove('hidden');
        contentAi.classList.add('hidden');
      }
    }
  </script>
</Layout>
