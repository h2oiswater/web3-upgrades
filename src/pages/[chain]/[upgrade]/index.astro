---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allItems = await getCollection('chains');
  const upgrades = allItems.filter(u => u.data.chainId && !u.data.upgradeId);
  return upgrades.map(u => ({
    params: { 
      chain: u.data.chainId,
      upgrade: u.data.id
    },
    props: { upgradeData: u.data },
  }));
}

const { chain, upgrade } = Astro.params;
const { upgradeData } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

// 读取特性
const allItems = await getCollection('chains');
const upgradeFeatures = allItems
  .filter(f => f.data.upgradeId === upgrade && f.data.chainId === chain)
  .sort((a, b) => (a.data.sortOrder || 999) - (b.data.sortOrder || 999));

// 获取链信息
const chainData = allItems.find(c => c.data.id === chain && !c.data.chainId)?.data;

const typeLabels: Record<string, string> = {
  execution: '执行层',
  consensus: '共识层',
  l2: '扩容/L2',
  economic: '经济模型',
  security: '安全',
  major: '里程碑',
};

const typeColors: Record<string, string> = {
  execution: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
  consensus: 'bg-purple-500/10 text-purple-400 border-purple-500/20',
  l2: 'bg-green-500/10 text-green-400 border-green-500/20',
  economic: 'bg-orange-500/10 text-orange-400 border-orange-500/20',
  security: 'bg-red-500/10 text-red-400 border-red-500/20',
  major: 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20',
};
---

<Layout title={`${upgradeData.nameZh || upgradeData.name} 升级详情`} description={upgradeData.summaryZh || upgradeData.summary}>
  <main class="min-h-screen max-w-4xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-[#6a6a80] mb-8">
      <a href={baseUrl} class="hover:text-[#8aa4f0]">首页</a>
      <span>/</span>
      {chainData && <a href={`${baseUrl}${chain}/`} class="hover:text-[#8aa4f0]">{chainData.nameZh}</a>}
      <span>/</span>
      <span class="text-[#9a9ab0]">{upgradeData.nameZh || upgradeData.name}</span>
    </nav>

    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-4 mb-4">
        <span class="text-4xl">{upgradeData.icon}</span>
        <div>
          <h1 class="text-3xl font-bold text-white">{upgradeData.nameZh || upgradeData.name}</h1>
          {upgradeData.blockNumber && (
            <span class="text-sm text-[#6a6a80]">区块 {upgradeData.blockNumber}</span>
          )}
        </div>
      </div>

      <div class="flex gap-2 flex-wrap mb-4">
        {upgradeData.type.map(t => (
          <span class={`px-3 py-1 rounded text-sm border ${typeColors[t] || 'bg-[#2a2a3a] text-[#9a9ab0]'}`}>
            {typeLabels[t] || t}
          </span>
        ))}
      </div>

      <p class="text-[#9a9ab0] leading-relaxed">{upgradeData.summaryZh || upgradeData.summary}</p>

      {upgradeData.date && (
        <div class="mt-4 text-sm text-[#6a6a80]">
          📅 {upgradeData.date}
        </div>
      )}
    </div>

    <!-- Features List -->
    <div class="space-y-4">
      <h2 class="text-xl font-bold text-white mb-4">包含的 EIP/特性</h2>
      
      {upgradeFeatures.map(f => (
        <a 
          href={`${baseUrl}${chain}/${upgrade}/${f.data.id}/`}
          class="block p-4 rounded-xl border border-[#2a2a3a] bg-[#16161e] hover:bg-[#1c1c26] hover:border-[#3a3a50] transition-all"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              {f.data.type === 'eip' && f.data.number && (
                <span class="font-mono text-sm px-2 py-1 rounded bg-[#627eea]/10 text-[#8aa4f0]">
                  EIP-{f.data.number}
                </span>
              )}
              <span class="font-medium text-white">{f.data.nameZh || f.data.name}</span>
              {f.data.major && (
                <span class="text-xs text-orange-400">⭐ 核心</span>
              )}
            </div>
            <svg class="w-5 h-5 text-[#6a6a80]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
