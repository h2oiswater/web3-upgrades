      { title: "11.4 ZK投票与治理", items: ["MACI：防贿选投票", "Snapshot Shielded：隐私DAO投票"] },
      { title: "11.5 新兴方向", items: ["ZKML：验证AI推理", "合规隐私：监管友好方案"] }
    ]
  },
  {
    id: 12, num: "12", title: "实战I：用Circom编写ZK电路", icon: "⚒️",
    category: "prac", categoryLabel: "实战项目",
    desc: "从环境搭建到三个完整项目：范围证明、Merkle成员证明、简单计算证明。掌握Circom开发全流程和安全注意事项。",
    goals: ["掌握Circom完整流程", "独立编写ZK电路", "理解安全漏洞"],
    concepts: ["Circom", "SnarkJS", "范围证明", "Merkle证明", "欠约束", "Circomspect"],
    summary: "本章是你第一个ZK电路的实战。范围证明教你证明一个数在区间内而不泄露值；Merkle证明教你在不泄露叶子的情况下证明成员身份——这正是Tornado Cash的核心电路。",
    sections: [
      { title: "12.1 开发环境搭建", items: ["安装Circom编译器和SnarkJS", "项目结构规划"] },
      { title: "12.2 项目一：范围证明", items: ["需求：证明数在0-100之间", "电路：二进制分解约束", "完整Circom代码", "编译→witness→证明→验证"] },
      { title: "12.3 项目二：Merkle成员证明", items: ["需求：不泄露叶子证明成员", "电路：Poseidon哈希链", "完整代码", "链上Merkle根验证"] },
      { title: "12.4 项目三：简单计算证明", items: ["需求：证明正确执行计算", "电路：乘法加法约束组合"] },
      { title: "12.5 安全注意事项", items: ["欠约束风险", "信号与变量区分", "审计工具：Circomspect、Picus"] }
    ]
  },
  {
    id: 13, num: "13", title: "实战II：用Noir与Solidity部署链上ZK", icon: "🔗",
    category: "prac", categoryLabel: "实战项目",
    desc: "构建端到端的ZK应用原型：用Noir编写隐私投票电路，生成Solidity验证合约，部署到Sepolia测试网。",
    goals: ["掌握Noir语言", "理解链上验证", "构建端到端应用"],
    concepts: ["Noir", "nargo", "barretenberg", "Solidity验证器", "Sepolia", "Gas成本"],
    summary: "从电路到链上验证的完整旅程。Noir是Rust风格的ZK语言，抽象层次比Circom更高。你将构建一个隐私投票系统：用户匿名投票，系统验证投票有效并计票。",
    sections: [
      { title: "13.1 Noir简介与环境", items: ["Noir设计哲学", "安装nargo和barretenberg", "Noir vs Circom选择指南"] },
      { title: "13.2 项目：隐私投票系统", items: ["需求分析", "Noir电路：验证投票权+匿名凭证", "完整Noir代码", "生成证明和验证密钥"] },
      { title: "13.3 Solidity验证合约", items: ["验证合约架构", "Groth16验证器集成", "PLONK验证器集成", "Gas成本分析：~200k-250k"] },
      { title: "13.4 部署到测试网", items: ["选择Sepolia+zkRollup测试网", "部署流程", "前端集成", "项目仓库结构"] }
    ]
  },
  {
    id: 14, num: "14", title: "进阶与未来：ZK技术前沿", icon: "🔮",
    category: "prac", categoryLabel: "进阶",
    desc: "展望ZK技术的最新前沿：递归证明、硬件加速、ZKML、ERC-4337+ZK，以及持续学习的资源地图。",
    goals: ["了解前沿方向", "建立持续学习路径", "掌握资源索引"],
    concepts: ["递归证明", "Halo2", "硬件加速", "ZKML", "ZK协处理器", "ERC-4337"],
    summary: "ZK技术仍在飞速演进。递归证明让'证明这个证明是正确的'成为可能；GPU/FPGA/ASIC正在将证明成本再降10倍；ZKML让AI推理可验证；ERC-4337+ZK正在重塑钱包体验。",
    sections: [
      { title: "14.1 递归证明", items: ["类比：证明的证明", "Halo与Halo2", "应用：轻客户端、证明聚合"] },
      { title: "14.2 硬件加速", items: ["GPU/FPGA/ASIC角色", "证明成本指数级下降"] },
      { title: "14.3 ZKML与ZK协处理器", items: ["Risc0、Jolt、EZKL", "链下计算+链上验证"] },
      { title: "14.4 账户抽象与ZK", items: ["ERC-4337 + ZK", "社交恢复、隐私交易、批量操作", "对钱包开发者的启示"] },
      { title: "14.5 持续学习资源地图", items: ["核心社区：0xPARC、PSE、ZK Hack", "关键会议：ZK Summit、zkDay", "推荐书单和论文路径"] },
      { title: "14.6 全教材回顾", items: ["数学筑基→电路转化→算法理解→应用实战", "从Frontier到Fusaka，从模运算到zkRollup"] }
    ]
  }
];

const categories = [
  { id: 'all', label: '全部' },
  { id: 'math', label: '数学基础' },
  { id: 'circuit', label: '电路基础' },
  { id: 'algo', label: '核心算法' },
  { id: 'app', label: '以太坊应用' },
  { id: 'prac', label: '实战项目' },
];

const roadmapSteps = [
  { num: 1, title: '数学筑基（第1-5章，4-6周）', desc: '模运算→群环域→椭圆曲线→多项式FFT。建立密码学数学直觉。' },
  { num: 2, title: '电路转化（第6章，1-2周）', desc: 'R1CS→QAP→Plonkish。理解如何把程序转化为约束系统。' },
  { num: 3, title: '算法理解（第7-9章，3-4周）', desc: 'Groth16→PLONK→STARK。掌握三大证明系统的工作流和权衡。' },
  { num: 4, title: '应用实战（第10-13章，3-4周）', desc: 'zkRollup对比→隐私应用→Circom实战→Noir+Solidity部署。' },
  { num: 5, title: '前沿进阶（第14章，持续）', desc: '递归证明、ZKML、硬件加速。加入0xPARC、PSE社区持续学习。' },
];
---

<Layout title="ZK 学习" description="零知识证明系统学习指南 - 从数学基础到链上实战，14章渐进式课程">
  <main class="min-h-screen bg-[#0A0A0F]">
    <!-- Hero -->
    <section class="relative py-20 px-4 text-center overflow-hidden bg-[#0A0A0F]">
      <div class="relative z-10 max-w-3xl mx-auto">
        <div class="w-16 h-16 mx-auto mb-6 rounded-xl bg-[#16161e] border border-[#2a2a3a] flex items-center justify-center text-2xl font-bold text-[#00d4aa]">
          ZK
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white">零知识证明学习指南</h1>
        <p class="text-lg text-[#9a9ab0] max-w-xl mx-auto">从数学基础到链上实战，14 章渐进式课程带你掌握零知识证明的核心原理与应用开发</p>
        
        <div class="flex justify-center gap-8 mt-10">
          <div class="text-center">
            <div class="text-3xl font-bold text-white">14</div>
            <div class="text-sm text-[#6a6a80]">系统章节</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-white">5</div>
            <div class="text-sm text-[#6a6a80]">学习阶段</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-white">12-16</div>
            <div class="text-sm text-[#6a6a80]">建议周数</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Filters -->
    <section class="max-w-6xl mx-auto px-4 mb-8">
      <div class="flex flex-wrap justify-center gap-2" id="zk-filters">
        {categories.map((cat, idx) => (
          <button 
            class={`zk-filter-btn px-4 py-2 text-sm rounded-full border transition-all ${idx === 0 ? 'bg-[rgba(0,212,170,0.15)] text-[#00d4aa] border-[rgba(0,212,170,0.3)]' : 'bg-[#16161e] text-[#6a6a80] border-[#2a2a3a] hover:border-[#3a3a4a] hover:text-[#9a9ab0]'}`}
            data-filter={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </section>

    <!-- Chapter Cards -->
    <section class="max-w-6xl mx-auto px-4 pb-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="zk-grid">
        {chapters.map((chapter, idx) => (
          <div 
            class="zk-card block p-6 rounded-xl border border-[#2a2a3a] bg-[#16161e] hover:bg-[#1c1c26] transition-all hover:-translate-y-1 cursor-pointer"
            data-category={chapter.category}
            data-id={chapter.id}
            style={`animation: fadeInUp 0.5s ease forwards; animation-delay: ${idx * 0.05}s; opacity: 0;`}
          >
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold text-[#00d4aa] bg-[rgba(0,212,170,0.1)] border border-[rgba(0,212,170,0.2)]">
                {chapter.num}
              </div>
              <h3 class="text-lg font-bold text-white">{chapter.title}</h3>
            </div>
            <p class="text-sm text-[#9a9ab0] mb-4 leading-relaxed">{chapter.desc}</p>
            <div class="mb-3">
              <div class="text-xs text-[#6a6a80] mb-1.5 uppercase tracking-wider font-semibold">学习目标</div>
              <div class="flex flex-wrap gap-1.5">
                {chapter.goals.map(g => (
                  <span class="px-2.5 py-1 text-xs rounded-full bg-[rgba(0,212,170,0.08)] text-[#00d4aa] border border-[rgba(0,212,170,0.15)]">{g}</span>
                ))}
              </div>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {chapter.concepts.map(c => (
                <span class="px-2.5 py-1 text-xs rounded-full bg-[#0f0f16] text-[#6a6a80] border border-[#2a2a3a]">{c}</span>
              ))}
            </div>
            <div class="mt-4 pt-3 border-t border-[#2a2a3a] flex gap-4 text-xs text-[#6a6a80]">
              <span>{chapter.sections.length} 节</span>
              <span>{chapter.concepts.length} 核心概念</span>
              <span class="text-[#00d4aa]">{chapter.categoryLabel}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Roadmap -->
    <section class="max-w-4xl mx-auto px-4 pb-20">
      <div class="p-6 rounded-xl border border-[#2a2a3a] bg-[#16161e]">
        <h3 class="text-xl font-bold text-white mb-6">📍 学习路线图</h3>
        {roadmapSteps.map(step => (
          <div class="flex gap-4 mb-4 pb-4 border-b border-[#2a2a3a] last:mb-0 last:pb-0 last:border-b-0">
            <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-[#00d4aa] bg-[rgba(0,212,170,0.1)] border border-[rgba(0,212,170,0.2)] flex-shrink-0">
              {step.num}
            </div>
            <div>
              <div class="text-sm font-semibold text-white mb-0.5">{step.title}</div>
              <div class="text-xs text-[#6a6a80]">{step.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <!-- Modal -->
  <div id="zk-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(8px);">
    <div class="w-full max-w-2xl max-h-[85vh] overflow-y-auto rounded-2xl border border-[#2a2a3a] bg-[#16161e] shadow-2xl">
      <div class="sticky top-0 z-10 flex items-center justify-between p-6 border-b border-[#2a2a3a] bg-[#16161e]">
        <div id="modal-title" class="text-xl font-bold text-white"></div>
        <button onclick="closeZKModal()" class="w-8 h-8 rounded-full bg-[#0f0f16] border border-[#2a2a3a] text-[#6a6a80] hover:text-white hover:border-[#3a3a4a] transition-all flex items-center justify-center text-lg">
          ×
        </button>
      </div>
      <div id="modal-body" class="p-6"></div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ chapters }}>
  // Filter logic
  const filterBtns = document.querySelectorAll('.zk-filter-btn');
  const cards = document.querySelectorAll('.zk-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-[rgba(0,212,170,0.15)]', 'text-[#00d4aa]', 'border-[rgba(0,212,170,0.3)]');
        b.classList.add('bg-[#16161e]', 'text-[#6a6a80]', 'border-[#2a2a3a]');
      });
      btn.classList.remove('bg-[#16161e]', 'text-[#6a6a80]', 'border-[#2a2a3a]');
      btn.classList.add('bg-[rgba(0,212,170,0.15)]', 'text-[#00d4aa]', 'border-[rgba(0,212,170,0.3)]');

      const filter = btn.dataset.filter;
      cards.forEach(card => {
        if (filter === 'all' || card.dataset.category === filter) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Modal logic
  const modal = document.getElementById('zk-modal');
  const modalTitle = document.getElementById('modal-title');
  const modalBody = document.getElementById('modal-body');

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const id = parseInt(card.dataset.id);
      const chapter = chapters.find(c => c.id === id);
      if (!chapter) return;

      modalTitle.innerHTML = `<span class="inline-block px-2.5 py-1 rounded text-sm font-mono bg-[rgba(0,212,170,0.1)] text-[#00d4aa] border border-[rgba(0,212,170,0.2)] mr-2">第${chapter.num}章</span>${chapter.title}`;
      
      const sectionsHtml = chapter.sections.map(s => `
        <div class="mb-5">
          <h4 class="text-sm font-semibold text-white mb-2">${s.title}</h4>
          <ul class="list-disc list-inside text-sm text-[#9a9ab0] leading-relaxed space-y-1">
            ${s.items.map(i => `<li>${i}</li>`).join('')}
          </ul>
        </div>
      `).join('');

      modalBody.innerHTML = `
        <div class="mb-6">
          <div class="text-xs uppercase tracking-wider text-[#6a6a80] font-semibold mb-2">📝 章节简介</div>
          <p class="text-sm text-[#9a9ab0] leading-relaxed">${chapter.desc}</p>
        </div>
        <div class="mb-6 p-4 rounded-lg border border-[rgba(0,212,170,0.15)] bg-[rgba(0,212,170,0.05)]">
          <div class="text-xs uppercase tracking-wider text-[#00d4aa] font-semibold mb-2">💡 核心洞察</div>
          <p class="text-sm text-[#9a9ab0] leading-relaxed">${chapter.summary}</p>
        </div>
        <div class="mb-6">
          <div class="text-xs uppercase tracking-wider text-[#6a6a80] font-semibold mb-2">🎯 学习目标</div>
          <div class="flex flex-wrap gap-2">
            ${chapter.goals.map(g => `<span class="px-2.5 py-1 text-xs rounded-full bg-[rgba(0,212,170,0.08)] text-[#00d4aa] border border-[rgba(0,212,170,0.15)]">${g}</span>`).join('')}
          </div>
        </div>
        <div class="mb-6">
          <div class="text-xs uppercase tracking-wider text-[#6a6a80] font-semibold mb-2">📚 章节结构（${chapter.sections.length}节）</div>
          ${sectionsHtml}
        </div>
        <div>
          <div class="text-xs uppercase tracking-wider text-[#6a6a80] font-semibold mb-2">🏷️ 核心概念</div>
          <div class="flex flex-wrap gap-2">
            ${chapter.concepts.map(c => `<span class="px-2.5 py-1 text-xs rounded-full bg-[#0f0f16] text-[#6a6a80] border border-[#2a2a3a]">${c}</span>`).join('')}
          </div>
        </div>
      `;

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    });
  });

  function closeZKModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeZKModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.classList.contains('flex')) {
      closeZKModal();
    }
  });
</script>

<style is:global>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
