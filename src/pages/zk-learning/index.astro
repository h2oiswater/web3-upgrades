---
import Layout from '../../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL;

const chapters = [
  { id: 1, num: "01", title: "导论：走进零知识证明的世界", icon: "🔐", category: "intro", categoryLabel: "导论", desc: "通过阿里巴巴洞穴、数独游戏、密封试卷三个经典类比，建立零知识证明的直觉认知。回顾从1985年Goldwasser-Micali-Rackoff提出概念到2026年zkRollup爆发的历史脉络。", goals: ["理解ZK三要素", "掌握经典类比", "了解历史里程碑"], concepts: ["完整性", "可靠性", "零知识性", "zk-SNARK", "zk-STARK"] },
  { id: 2, num: "02", title: "数学基础I：模运算与有限域", icon: "➗", category: "math", categoryLabel: "数学基础", desc: "从时钟算术的直觉出发，掌握模运算的代数规则。理解有限域的构造和运算性质，并用Python实现有限域上的加减乘除。", goals: ["理解模运算直觉", "掌握有限域性质", "实现Fp运算代码"], concepts: ["模运算", "同余", "有限域Fp", "素域", "扩展域", "逆元"] },
  { id: 3, num: "03", title: "数学基础II：群、环、域", icon: "🔁", category: "math", categoryLabel: "数学基础", desc: "从魔方操作群到整数环，掌握抽象代数的核心结构。理解循环群、生成元、阶的概念，为椭圆曲线群结构做准备。", goals: ["理解群环域定义", "掌握循环群结构", "探索有限域乘法群"], concepts: ["群", "环", "域", "循环群", "生成元", "阶", "拉格朗日定理"] },
  { id: 4, num: "04", title: "数学基础III：椭圆曲线与双线性配对", icon: "📈", category: "math", categoryLabel: "数学基础", desc: "从过山车轨道的几何直觉出发，理解椭圆曲线在有限域上的密码学应用。掌握双线性配对的核心概念——ZK安全性的基石。", goals: ["理解椭圆曲线群结构", "掌握ECDLP问题", "理解双线性配对"], concepts: ["椭圆曲线", "点加法", "标量乘法", "ECDLP", "配对", "BN254", "BLS12-381"] },
  { id: 5, num: "05", title: "数学基础IV：多项式、插值与FFT", icon: "📊", category: "math", categoryLabel: "数学基础", desc: "理解多项式在ZK中的核心地位。掌握拉格朗日插值和FFT/NTT，这是连接数学基础与ZK算法的桥梁。", goals: ["理解多项式在ZK中的地位", "掌握拉格朗日插值", "理解FFT/NTT加速"], concepts: ["多项式", "拉格朗日插值", "FFT", "NTT", "多项式承诺", "KZG"] },
  { id: 6, num: "06", title: "电路基础：从程序到约束系统", icon: "⚡", category: "circuit", categoryLabel: "电路基础", desc: "理解算术电路的概念和构造方法。掌握R1CS约束系统和QAP转化，这是将'计算'转化为'可证明数学问题'的桥梁。", goals: ["理解算术电路", "掌握R1CS", "理解QAP转化", "了解Plonkish"], concepts: ["算术电路", "门", "线", "R1CS", "QAP", "Plonkish", "置换论证"] },
  { id: 7, num: "07", title: "核心算法I：zk-SNARK与Groth16", icon: "🎯", category: "algo", categoryLabel: "核心算法", desc: "掌握最经典的SNARK实现——Groth16。理解可信设置、CRS、证明生成和验证的完整流程，并用SnarkJS完成全流程实战。", goals: ["理解SNARK工作流程", "掌握Groth16三阶段", "理解可信设置风险"], concepts: ["zk-SNARK", "Groth16", "可信设置", "CRS", "证明", "验证", "配对"] },
  { id: 8, num: "08", title: "核心算法II：PLONK与通用可信设置", icon: "🔑", category: "algo", categoryLabel: "核心算法", desc: "理解PLONK如何解决Groth16的每电路可信设置问题。掌握KZG多项式承诺，以及PLONK的Round 1-5证明流程。", goals: ["理解PLONK动机", "掌握KZG承诺", "理解PLONK证明流程"], concepts: ["PLONK", "通用可信设置", "KZG承诺", "零测试", "Fiat-Shamir", "TurboPLONK"] },
  { id: 9, num: "09", title: "核心算法III：zk-STARK与透明证明", icon: "🛡️", category: "algo", categoryLabel: "核心算法", desc: "理解zk-STARK——无需可信设置、抗量子的替代路线。掌握FRI协议的'折纸游戏'直觉，以及STARK与SNARK的核心差异。", goals: ["理解STARK vs SNARK", "掌握FRI直觉", "理解透明证明权衡"], concepts: ["zk-STARK", "FRI", "AIR", "透明证明", "抗量子", "哈希承诺"] },
  { id: 10, num: "10", title: "以太坊ZK应用I：zkRollup扩容", icon: "🚀", category: "app", categoryLabel: "以太坊应用", desc: "深入理解zkRollup架构和zkEVM分类。对比zkSync、Scroll、StarkNet、Polygon等主流方案的技术取舍和2025-2026最新动态。", goals: ["理解zkRollup架构", "掌握zkEVM分类", "对比主流方案"], concepts: ["zkRollup", "zkEVM", "排序器", "证明器", "数据可用性", "Blob", "EIP-4844"] },
  { id: 11, num: "11", title: "以太坊ZK应用II：隐私与身份", icon: "👤", category: "app", categoryLabel: "以太坊应用", desc: "探索ZK在隐私保护中的独特价值。理解Tornado Cash的技术原理、zkLogin身份验证、以及ZK投票和ZKML等新兴方向。", goals: ["理解隐私ZK价值", "掌握Tornado Cash原理", "了解ZK身份应用"], concepts: ["隐私ZK", "Tornado Cash", "zkLogin", "World ID", "zkKYC", "ZKML", "MACI"] },
  { id: 12, num: "12", title: "实战I：用Circom编写ZK电路", icon: "⚒️", category: "prac", categoryLabel: "实战项目", desc: "从环境搭建到三个完整项目：范围证明、Merkle成员证明、简单计算证明。掌握Circom开发全流程和安全注意事项。", goals: ["掌握Circom完整流程", "独立编写ZK电路", "理解安全漏洞"], concepts: ["Circom", "SnarkJS", "范围证明", "Merkle证明", "欠约束", "Circomspect"] },
  { id: 13, num: "13", title: "实战II：用Noir与Solidity部署链上ZK", icon: "🔗", category: "prac", categoryLabel: "实战项目", desc: "构建端到端的ZK应用原型：用Noir编写隐私投票电路，生成Solidity验证合约，部署到Sepolia测试网。", goals: ["掌握Noir语言", "理解链上验证", "构建端到端应用"], concepts: ["Noir", "nargo", "barretenberg", "Solidity验证器", "Sepolia", "Gas成本"] },
  { id: 14, num: "14", title: "进阶与未来：ZK技术前沿", icon: "🔮", category: "prac", categoryLabel: "进阶", desc: "展望ZK技术的最新前沿：递归证明、硬件加速、ZKML、ERC-4337+ZK，以及持续学习的资源地图。", goals: ["了解前沿方向", "建立持续学习路径", "掌握资源索引"], concepts: ["递归证明", "Halo2", "硬件加速", "ZKML", "ZK协处理器", "ERC-4337"] },
];

const categories = [
  { id: 'all', label: '全部' },
  { id: 'math', label: '数学基础' },
  { id: 'circuit', label: '电路基础' },
  { id: 'algo', label: '核心算法' },
  { id: 'app', label: '以太坊应用' },
  { id: 'prac', label: '实战项目' },
];

const roadmapSteps = [
  { num: 1, title: '数学筑基（第1-5章，4-6周）', desc: '模运算→群环域→椭圆曲线→多项式FFT。建立密码学数学直觉。' },
  { num: 2, title: '电路转化（第6章，1-2周）', desc: 'R1CS→QAP→Plonkish。理解如何把程序转化为约束系统。' },
  { num: 3, title: '算法理解（第7-9章，3-4周）', desc: 'Groth16→PLONK→STARK。掌握三大证明系统的工作流和权衡。' },
  { num: 4, title: '应用实战（第10-13章，3-4周）', desc: 'zkRollup对比→隐私应用→Circom实战→Noir+Solidity部署。' },
  { num: 5, title: '前沿进阶（第14章，持续）', desc: '递归证明、ZKML、硬件加速。加入0xPARC、PSE社区持续学习。' },
];
---

<Layout title="ZK 学习" description="零知识证明系统学习指南 - 从数学基础到链上实战，14章渐进式课程">
  <main class="min-h-screen bg-[#0A0A0F]">
    <!-- Hero -->
    <section class="relative py-20 px-4 text-center overflow-hidden bg-[#0A0A0F]">
      <div class="relative z-10 max-w-3xl mx-auto">
        <div class="w-16 h-16 mx-auto mb-6 rounded-xl bg-[#16161e] border border-[#2a2a3a] flex items-center justify-center text-2xl font-bold text-[#00d4aa]">
          ZK
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white">零知识证明学习指南</h1>
        <p class="text-lg text-[#9a9ab0] max-w-xl mx-auto">从数学基础到链上实战，14 章渐进式课程带你掌握零知识证明的核心原理与应用开发</p>
        <div class="flex justify-center gap-8 mt-10">
          <div class="text-center"><div class="text-3xl font-bold text-white">14</div><div class="text-sm text-[#6a6a80]">系统章节</div></div>
          <div class="text-center"><div class="text-3xl font-bold text-white">5</div><div class="text-sm text-[#6a6a80]">学习阶段</div></div>
          <div class="text-center"><div class="text-3xl font-bold text-white">12-16</div><div class="text-sm text-[#6a6a80]">建议周数</div></div>
        </div>
      </div>
    </section>

    <!-- Filters -->
    <section class="max-w-6xl mx-auto px-4 mb-8">
      <div class="flex flex-wrap justify-center gap-2" id="zk-filters">
        {categories.map((cat, idx) => (
          <button 
            class={`zk-filter-btn px-4 py-2 text-sm rounded-full border transition-all ${idx === 0 ? 'bg-[rgba(0,212,170,0.15)] text-[#00d4aa] border-[rgba(0,212,170,0.3)]' : 'bg-[#16161e] text-[#6a6a80] border-[#2a2a3a] hover:border-[#3a3a4a] hover:text-[#9a9ab0]'}`}
            data-filter={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </section>

    <!-- Chapter Cards -->
    <section class="max-w-6xl mx-auto px-4 pb-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="zk-grid">
        {chapters.map((chapter, idx) => (
          <a 
            href={`${baseUrl}zk-learning/${String(chapter.id).padStart(2, '0')}/`}
            class="zk-card block p-6 rounded-xl border border-[#2a2a3a] bg-[#16161e] hover:bg-[#1c1c26] transition-all hover:-translate-y-1"
            data-category={chapter.category}
            style={`animation: fadeInUp 0.5s ease forwards; animation-delay: ${idx * 0.05}s; opacity: 0;`}
          >
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold text-[#00d4aa] bg-[rgba(0,212,170,0.1)] border border-[rgba(0,212,170,0.2)]">
                {chapter.num}
              </div>
              <h3 class="text-lg font-bold text-white">{chapter.title}</h3>
            </div>
            <p class="text-sm text-[#9a9ab0] mb-4 leading-relaxed">{chapter.desc}</p>
            <div class="mb-3">
              <div class="text-xs text-[#6a6a80] mb-1.5 uppercase tracking-wider font-semibold">学习目标</div>
              <div class="flex flex-wrap gap-1.5">
                {chapter.goals.map(g => (
                  <span class="px-2.5 py-1 text-xs rounded-full bg-[rgba(0,212,170,0.08)] text-[#00d4aa] border border-[rgba(0,212,170,0.15)]">{g}</span>
                ))}
              </div>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {chapter.concepts.map(c => (
                <span class="px-2.5 py-1 text-xs rounded-full bg-[#0f0f16] text-[#6a6a80] border border-[#2a2a3a]">{c}</span>
              ))}
            </div>
            <div class="mt-4 pt-3 border-t border-[#2a2a3a] flex gap-4 text-xs text-[#6a6a80]">
              <span class="text-[#00d4aa]">{chapter.categoryLabel}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Roadmap -->
    <section class="max-w-4xl mx-auto px-4 pb-20">
      <div class="p-6 rounded-xl border border-[#2a2a3a] bg-[#16161e]">
        <h3 class="text-xl font-bold text-white mb-6">📍 学习路线图</h3>
        {roadmapSteps.map(step => (
          <div class="flex gap-4 mb-4 pb-4 border-b border-[#2a2a3a] last:mb-0 last:pb-0 last:border-b-0">
            <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-[#00d4aa] bg-[rgba(0,212,170,0.1)] border border-[rgba(0,212,170,0.2)] flex-shrink-0">
              {step.num}
            </div>
            <div>
              <div class="text-sm font-semibold text-white mb-0.5">{step.title}</div>
              <div class="text-xs text-[#6a6a80]">{step.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  const filterBtns = document.querySelectorAll('.zk-filter-btn');
  const cards = document.querySelectorAll('.zk-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-[rgba(0,212,170,0.15)]', 'text-[#00d4aa]', 'border-[rgba(0,212,170,0.3)]');
        b.classList.add('bg-[#16161e]', 'text-[#6a6a80]', 'border-[#2a2a3a]');
      });
      btn.classList.remove('bg-[#16161e]', 'text-[#6a6a80]', 'border-[#2a2a3a]');
      btn.classList.add('bg-[rgba(0,212,170,0.15)]', 'text-[#00d4aa]', 'border-[rgba(0,212,170,0.3)]');

      const filter = btn.dataset.filter;
      cards.forEach(card => {
        if (filter === 'all' || card.dataset.category === filter) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style is:global>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
