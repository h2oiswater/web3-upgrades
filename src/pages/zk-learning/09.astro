      <td><strong>抗碰撞哈希函数</strong>[^97^]</td>
    </tr>
    <tr>
      <td><strong>核心密码学工具</strong></td>
      <td>KZG承诺 + 配对验证</td>
      <td>KZG承诺 + 置换论证</td>
      <td><strong>FRI + Merkle树 + 哈希</strong>[^115^]</td>
    </tr>
    <tr>
