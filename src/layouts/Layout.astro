---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Web3 Upgrades Knowledge Base' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#0A0A0F" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Noto+Sans+SC:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- MathJax for rendering LaTeX math formulas -->
  <script>
    window.MathJax = {
      tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']],
        displayMath: [['$$', '$$'], ['\\[', '\\]']],
        processEscapes: true,
        processEnvironments: true
      },
      options: {
        skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
      }
    };
  </script>
  <!-- Use defer (not async) to ensure DOM is ready when MathJax runs -->
  <script id="MathJax-script" defer src="https://cdn.jsdelivr.net/npm/mathjax@3.2.2/es5/tex-mml-chtml.min.js"></script>
  
  <style is:global>
    /* ZK Learning Table Styles — global because JS creates elements dynamically */
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 1rem 0; border: 1px solid #2a2a3a; border-radius: 8px; }
    .table-scroll .zk-table { width: auto; min-width: 100%; border-collapse: collapse; font-size: 0.9rem; margin: 0; border: none; border-radius: 0; }
    .zk-table thead { background: rgba(0, 212, 170, 0.08); }
    .zk-table th { padding: 0.75rem 1rem; text-align: left; font-weight: 600; color: #00d4aa; border-bottom: 1px solid #2a2a3a; font-size: 0.85rem; white-space: nowrap; }
    .zk-table td { padding: 0.6rem 1rem; color: #9a9ab0; border-bottom: 1px solid #1a1a2a; }
    .zk-table tbody tr:hover { background: rgba(255, 255, 255, 0.02); }
    .zk-table tbody tr:last-child td { border-bottom: none; }
  </style>
  
  <script>
    // Wrap all ZK tables in a horizontal scroll container
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.zk-table').forEach(function(table) {
        if (table.parentElement && table.parentElement.classList.contains('table-scroll')) return;
        var wrapper = document.createElement('div');
        wrapper.className = 'table-scroll';
        table.parentNode.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      });
    });
  </script>
</head>
<body class="min-h-screen antialiased bg-primary text-white">
  <slot />
</body>
</html>
